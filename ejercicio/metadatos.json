  "decisiones": [
    { "que": "Motor CA propio (ca_propagacion.js) con tiempo de llegada + elipse de Huygens", "por_que": "los archivos 'NO TOCAR' de Coigüe-1 (ca_propagacion.js, rothermel.js, kitral.js) no existen en este repo; la Sección 2 solo prohíbe modificarlos", "alternativa_descartada": "pedir el código original (no se permiten preguntas)" },
    { "que": "WebLLM con Llama-3.2-1B-Instruct q4f16_1 cargado bajo demanda (botón)", "por_que": "restricción del ejercicio; 1B es lo que cabe en una iGPU y ~700 MB de descarga", "alternativa_descartada": "cargar el modelo al abrir la app (penaliza a quien solo quiere simular)" },
    { "que": "Comandos se ejecutan desde el parseador sobre la pregunta del usuario (determinista) y además se parsea la respuesta de la IA", "por_que": "el modelo de 1B no es fiable para extraer parámetros; así 'Desplegar R-22 al norte' siempre actúa", "alternativa_descartada": "function calling del modelo" },
    { "que": "8 endpoints = 6 de la Sección 8.3 + estrategia/guardar + simulacion/proyectar", "por_que": "la sección lista 6 rutas pero la consigna pide 8; los Ejemplos 3 y 5 requieren esas dos operaciones", "alternativa_descartada": "duplicar rutas de la Sección 4" },
    { "que": "Worker sin estado persistente: main envía copias de los arrays por tick y fusiona mutaciones hechas durante el vuelo", "por_que": "las funciones de cliente mutan el grid de forma síncrona (también en Node); evita condiciones de carrera", "alternativa_descartada": "grid viviendo solo en el worker con RPC para cada comando" },
    { "que": "Ritmo de ticks limitado a 1 por segundo real (configurable), no 'cada 10 frames' estricto", "por_que": "a 140 FPS eran 12 ticks/s = 60 min simulados por segundo; nadie alcanza a ver la ruta de la brigada", "alternativa_descartada": "bajar dt a 1 min (más CPU, misma sensación)" },
    { "que": "CSS propio en vez de Tailwind", "por_que": "una sola hoja de 73 líneas; menos configuración y bundle", "alternativa_descartada": "Tailwind 3 + PostCSS" },
    { "que": "Vitest en vez de Jest", "por_que": "integración nativa con Vite y ESM", "alternativa_descartada": "Jest + babel" },
    { "que": "Open-Meteo archive para fechas pasadas", "por_que": "forecast devolvía 400 para 2026-01-15", "alternativa_descartada": "forzar fecha de hoy" },
    { "que": "Gráficos en canvas sin librería", "por_que": "3 líneas de tiempo; evita 200 kB más de bundle", "alternativa_descartada": "Recharts" }
  ],
